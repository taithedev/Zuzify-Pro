{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZuzifyPro",
  "version": "1.0.0",
  "identifier": "com.zuzify.pro",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZuzifyPro",
        "width": 660,
        "height": 441,
        "minWidth": 580,
        "minHeight": 380,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#25282b"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ZuzifyPro native Windows desktop application",
    "longDescription": "A compact, functional Windows desktop interface powered by Tauri 2 and WebView2."
  }
}
