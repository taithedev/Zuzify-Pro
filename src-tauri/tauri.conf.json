{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WidSetV2",
  "version": "2.0.0",
  "identifier": "com.zuzify.widsetv2",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WidSetV2 — Windows Control Center",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "WidSetV2 — Windows settings, organized",
    "longDescription": "Native Windows control center featuring direct personal settings and safe links to system configuration."
  }
}
